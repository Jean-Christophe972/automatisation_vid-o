# Copier en .env pour un test local. En production, ces valeurs vont dans les Variables Railway.
# Ne JAMAIS committer de vraies valeurs.
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DATABASE_URL=
REDIS_URL=

# Facultatif : réglages Gemini (valeurs par défaut dans le code)
GEMINI_TEXT_MODEL=
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=

# Décors dessinés par IA (fal.ai) pour les stories ; optionnel
FAL_KEY=
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# v0.5 dessin animé (optionnels)
# FAL_VIDEO_MODEL=fal-ai/ltx-2.3-22b/distilled/image-to-video
# MAX_COST_PER_PART=1.5        # plafond d'animation par partie, en dollars
# ANIMATION=on                 # off = images avec zoom lent, sans animation IA
# GEMINI_TTS_VOICE=Charon      # /voix dans Telegram pour comparer
# GEMINI_TEXT_FALLBACKS=gemini-3.5-pro,gemini-2.5-flash
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
