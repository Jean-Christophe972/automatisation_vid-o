{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.json",
  "title": "Storyboard d'une partie d'histoire stickman",
  "description": "Produit par le LLM, validé avant rendu. Une histoire = 2 ou 3 storyboards (une par partie).",
  "type": "object",
  "required": ["story_id", "part", "parts_total", "language", "hook", "characters", "scenes", "cliffhanger"],
  "additionalProperties": false,
  "properties": {
    "story_id": {"type": "string", "pattern": "^[a-z0-9-]{3,64}$"},
    "part": {"type": "integer", "minimum": 1, "maximum": 3},
    "parts_total": {"type": "integer", "minimum": 2, "maximum": 3},
    "language": {"enum": ["fr", "en"]},
    "hook": {"type": "string", "minLength": 10, "maxLength": 140, "description": "Phrase des 2 premières secondes"},
    "characters": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name", "color", "voice"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]{1,32}$"},
          "name": {"type": "string", "maxLength": 40},
          "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
          "accessory": {"enum": ["none", "cap", "glasses", "hat", "scarf", "bag", "tie"]},
          "voice": {"type": "string", "description": "Nom de voix Gemini TTS + consigne de ton"}
        }
      }
    },
    "scenes": {
      "type": "array", "minItems": 4, "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["id", "background", "duration_s", "narration", "actors"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "background": {"enum": ["room", "street", "forest", "office", "night_sky", "house_exterior", "corridor", "plain"]},
          "duration_s": {"type": "number", "minimum": 1.5, "maximum": 12},
          "narration": {"type": "string", "maxLength": 300},
          "actors": {
            "type": "array", "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["character", "pose", "x"],
              "additionalProperties": false,
              "properties": {
                "character": {"type": "string"},
                "pose": {"enum": ["stand", "walk", "run", "point", "sit", "fall", "jump", "scared", "think", "wave", "knock", "hide"]},
                "x": {"type": "number", "minimum": 0, "maximum": 1, "description": "Position horizontale (0 = gauche, 1 = droite)"},
                "facing": {"enum": ["left", "right"]},
                "bubble": {"type": "string", "maxLength": 80}
              }
            }
          },
          "props": {"type": "array", "maxItems": 5, "items": {"enum": ["door", "closet", "lamp", "phone", "car", "tree", "table", "window", "bed", "key"]}},
          "sfx": {"enum": ["none", "knock", "door_creak", "footsteps", "wind", "heartbeat", "whoosh", "thud"]}
        }
      }
    },
    "cliffhanger": {"type": "string", "maxLength": 140, "description": "Dernière phrase, renvoie à la partie suivante"}
  }
}
